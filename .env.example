# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/cavli_hubble?schema=public"

# Required header value for POST /api/scrape/exhibitors (min 16 characters)
SCRAPE_SECRET="replace-with-a-long-random-string"
# Minimum seconds between successful scrapes (default 300)
SCRAPE_COOLDOWN_SECONDS=300

# Google Calendar + Meet (OAuth 2.0 client, refresh token from OAuth Playground)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REFRESH_TOKEN="your-refresh-token"
GOOGLE_CALENDAR_ID="primary"

# Gmail account that sends booking confirmations (App Password, not the account password)
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"
